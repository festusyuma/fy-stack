{
  "name": "@fy-stack/cdn-construct",
  "version": "0.0.147",
  "repository": "https://github.com/festusyuma/fy-stack",
  "dependencies": {
    "@fy-stack/types": "0.0.147",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "^10.5.1"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "cdn-construct",
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "../../coverage/packages/cdn-construct"
        }
      }
    }
  }
}
